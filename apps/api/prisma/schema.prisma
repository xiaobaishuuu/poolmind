// PoolMind 数据库 schema。
// 本单元（脚手架）只放 datasource + generator，用来验证「后端能连上数据库、迁移能跑通」。
// 真正的业务数据模型（User / Certificate / SupervisorLink / Assignment / PaymentConfirmation 等，
// 见 .omc/plans/poolmind-phase1-plan.md「数据模型骨架」）由后续单元逐个补齐，这里先不建任何表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 占位模型：Prisma 硬性要求 schema 至少有一张表，才能生成 client、跑迁移。
/// 本单元没有任何真实业务模型，故放一张空占位表，仅用来证明「迁移能连库跑通、client 能生成」。
/// 后续单元开始建真实模型（User / Certificate / Assignment 等）时，删掉本表。
model ScaffoldPlaceholder {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}
